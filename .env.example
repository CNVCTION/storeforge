# StoreForge runtime
STOREFORGE_ENV=development
STOREFORGE_PORT=8787
STOREFORGE_PUBLIC_URL=http://localhost:8787

# Storage
DATABASE_URL=postgresql://storeforge:storeforge@localhost:5432/storeforge
STORAGE_DRIVER=local
STORAGE_PATH=./.data/media

# Active commerce backend: Medusa v2 Store API
COMMERCE_PROVIDER=medusa
COMMERCE_BASE_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=
MEDUSA_CURRENCY_CODE=usd
MEDUSA_WEBHOOK_SECRET=

# Active server-side persistence: Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=store-assets

# Optional model adapter selection; the mock adapter works without credentials.
MODEL_PROVIDER=mock
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Optional payments; never commit live values.
PAYMENTS_PROVIDER=disabled
PAYMENTS_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=
