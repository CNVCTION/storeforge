# Public browser-safe Supabase values. Never put the service-role key in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key

# Server-only values for trusted Vercel functions or server actions.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
