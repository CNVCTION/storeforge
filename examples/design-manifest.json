{
  "schemaVersion": "1.0",
  "brief": "Create a dark editorial storefront for limited-run posters and apparel using the supplied synthetic demo references.",
  "syntheticDemo": true,
  "assets": [
    {
      "path": "examples/assets/logo.png",
      "kind": "logo",
      "purpose": "synthetic brand mark",
      "synthetic": true
    },
    {
      "path": "examples/assets/moodboard.png",
      "kind": "moodboard",
      "purpose": "synthetic visual direction",
      "synthetic": true
    },
    {
      "path": "examples/assets/home-reference.png",
      "kind": "screenshot",
      "purpose": "synthetic homepage composition reference",
      "synthetic": true
    },
    {
      "path": "examples/assets/product-poster.png",
      "kind": "product-image",
      "purpose": "synthetic poster product reference",
      "synthetic": true
    },
    {
      "path": "examples/assets/product-shirt.png",
      "kind": "product-image",
      "purpose": "synthetic apparel product reference",
      "synthetic": true
    }
  ],
  "productData": "examples/demo-product-input.json",
  "constraints": {
    "doNotInvent": [
      "prices",
      "inventory",
      "shipping rates",
      "tax rules",
      "payment credentials",
      "legal policies"
    ]
  }
}
